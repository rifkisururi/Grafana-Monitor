    { "id": 1, "title": "HTTP p95 latency by route", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }, "targets": [{ "expr": "1000 * histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"aspnet-api\",http_route=~\"/api/.*|/health/live\"}[30s])))", "legendFormat": "{{http_route}}", "refId": "A" }] },
    { "id": 2, "title": "HTTP request rate by route", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [{ "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"aspnet-api\",http_route=~\"/api/.*|/health/live\"}[30s]))", "legendFormat": "{{http_route}}", "refId": "A" }] },
    { "id": 3, "title": "HTTP 5xx rate", "type": "timeseries", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [{ "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"aspnet-api\",http_response_status_code=~\"5..\"}[30s]))", "legendFormat": "{{http_route}}", "refId": "A" }] },
