# Local development only: replace both values with unique random values.
# Do not expose services publicly or commit your populated .env file.
POSTGRES_PASSWORD=local-demo-change-this
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-demo-change-this-too
DB_POOL_MAX_SIZE=4
DEMO_HEAVY_SLEEP_SECONDS=3
DEMO_REPORT_MODE=slow
API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Optional remote PostgreSQL URI. Leave empty for local Compose PostgreSQL.
# Never commit credentials. Rotate any URL previously shared in chat.
DATABASE_URL=
# Local Compose network. Set to an already-existing network only when needed.
DOCKER_NETWORK=grafana-monitor-demo
